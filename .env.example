# Thales CipherTrust AI Perimeter Configuration
# Copy this file to .env and update with your environment-specific values

# --- Thales CRDP Configuration ---
# Base URL for Thales CipherTrust RESTful Data Protection (CRDP) service
# Format: http://crdp-service.default.svc.cluster.local:8090/v1
CRDP_URL=http://crdp-service.default.svc.cluster.local:8090/v1

# CRDP Protection Policy Name
# Must match a policy configured in your Thales CipherTrust Manager
CRDP_POLICY=llm-ssn-tokenize-policy

# --- Ollama LLM Configuration ---
# Base URL for Ollama API service
# Format: http://ollama-service.llm-security-demo.svc.cluster.local:11434
OLLAMA_URL=http://ollama-service.llm-security-demo.svc.cluster.local:11434/api/chat

# Model name to use with Ollama
# Tested models: qwen2.5:1.5b, mistral, llama2
MODEL_NAME=qwen2.5:1.5b

# --- Data Storage Configuration ---
# Path to the enterprise knowledge base file (inside container)
# Must be mounted from CTE-protected volume
KNOWLEDGE_PATH=/data/enterprise_knowledge.txt

# --- Streamlit Configuration (Optional) ---
# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Streamlit logger level
STREAMLIT_LOGGER_LEVEL=info

# --- JWT Token Configuration (if using token-based auth instead of plaintext username) ---
# Base64-encoded JWT tokens for different user personas (optional)
# ALICE_JWT=Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
# BOB_JWT=Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
# ROGUE_JWT=Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
